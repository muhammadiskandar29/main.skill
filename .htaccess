<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /main.skill/

  # If request directly to a file or folder inside dist, allow it
  RewriteRule ^dist/ - [L]

  # Route everything else to dist folder
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)$ dist/index.html [L]
</IfModule>
